# No real credentials. Store completed file only at /etc/hermes/runtime.env, mode 0600.
NODE_ENV=production
HERMES_DEPLOYMENT_MODE=persistent-host
HERMES_DATA_DIR=/var/lib/hermes
HERMES_PERSISTENT_DISK_CONFIRMED=false
DASHBOARD_HOSTS=REPLACE_WITH_YOUR_HOST
GMAIL_PROVIDER=composio
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_USER_ID=marcus-os
COMPOSIO_CALLBACK_URL=https://REPLACE_WITH_YOUR_HOST/api/gmail/composio/callback
# Direct Google OAuth is optional when GMAIL_PROVIDER=google.
GMAIL_REDIRECT_URI=https://REPLACE_WITH_YOUR_HOST/api/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=
NOTION_API_TOKEN=
# Set to true only AFTER the old CRM sender and the Mac Gmail sender are OFF.
HERMES_LEGACY_SENDER_DISABLED=false
# Set only after delivery history and permanent suppression from both old senders are reconciled.
HERMES_HISTORY_RECONCILED=false
# Explicit source IDs are filled in the deployment README after adapter review.
NOTION_COMPANIES_DATA_SOURCE_ID=e52e94bc-1536-4467-b595-80cafadf63fa
NOTION_PEOPLE_DATA_SOURCE_ID=a814d082-803b-4f07-b69d-81afadd329cb
# Off until the revision-check limits in the deployment review are accepted.
HERMES_NOTION_STAGE_WRITES_APPROVED=false
